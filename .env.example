# Resend
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# Adres strony wypisu (List-Unsubscribe); w szablonach Resend uzywaj wbudowanej zmiennej {{{UNSUBSCRIBE_URL}}}
RESEND_UNSUBSCRIBE_URL=

# Supabase
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (tylko publiczne formularze, nie panel)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sekret chroniacy endpoint przetwarzania kolejki (worker cron -> /api/cron/process-queue)
QUEUE_CRON_SECRET=

# --- Modul UTM -------------------------------------------------------------
# Baza krotkich linkow /l/{slug}. Puste = origin biezacego zadania.
PUBLIC_SHORT_LINK_BASE=
# Sekret dla /api/webhooks/utm-attribution (landing -> HUB) oraz sol do
# haszowania IP w utm_clicks. Bez niego IP nie jest zapisywane w zadnej formie.
UTM_INGEST_SECRET=
# Token API Bitly (przycisk „Skroc w Bitly"). Puste = przycisk ukryty,
# krotki link mozna wtedy wkleic recznie.
BITLY_TOKEN=
# Wlasna domena markowa w Bitly, np. link.auraexpert.pl. Puste = bit.ly
BITLY_DOMAIN=
# Miesieczny limit linkow planu Bitly (Starter = 50).
BITLY_MONTHLY_LIMIT=50
